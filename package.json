{
  "name": "business-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI personal assistant for businesses — governance spine (Phase 0)",
  "engines": {
    "node": ">=22.15"
  },
  "allowScripts": [
    "esbuild"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:test": "tsx src/db/migrate.ts --test-db",
    "sdk:know-reader": "tsx src/sdk/run-know-reader.ts",
    "sdk:read-document": "tsx src/sdk/run-read-document.ts",
    "sdk:propose": "tsx src/sdk/run-propose.ts",
    "scheduler": "tsx src/orchestrator/run-scheduler.ts",
    "dashboard": "tsx src/dashboard/run-dashboard.ts",
    "owner:create": "tsx src/cli/create-owner.ts",
    "owner:password": "tsx src/cli/owner-password.ts",
    "job:seed": "tsx src/cli/seed-job.ts",
    "ramp:set": "tsx src/cli/set-ramp.ts",
    "kill": "tsx src/cli/kill.ts",
    "secret": "tsx src/cli/secret.ts",
    "secret:key": "tsx src/cli/secret-key.ts",
    "doc:ingest": "tsx src/cli/ingest-doc.ts",
    "sdk:curator": "tsx src/sdk/run-curator.ts",
    "sdk:contact-resolver": "tsx src/sdk/run-contact-resolver.ts",
    "sdk:delegate": "tsx src/sdk/run-delegate.ts",
    "sdk:judge": "tsx src/sdk/run-judge.ts",
    "sdk:mail-triage": "tsx src/sdk/run-mail-triage.ts",
    "connector:calendar": "tsx scripts/connector-calendar.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.234",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.1",
    "nodemailer": "^10.1.7",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "ulid": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "argparse": "^2.0.1"
  }
}

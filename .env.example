# Copy to .env and fill in. .env is gitignored — this file is not.
# Never put a real password here: git history is permanent, and a value
# committed once survives every later deletion.

# Postgres — the single store for memory layers L0-L5 and the audit chain.
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/assistant_dev
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/assistant_test

# Instance identity. One deployment serves exactly one business.
BUSINESS_ID=dev-business

# The one directory the reading agent (know.reader) is scoped to, and where
# ingestDocument (src/documents/ingest.ts) stores every document's original
# bytes, under <DOCUMENT_ROOT>/<businessId>/<documentId>/original.<ext>.
# Required, not defaulted: a deploy that forgot it would store documents
# somewhere the reader was never told about. A relative value like the
# default below is resolved once, in src/config.ts, against the process's
# cwd at startup — every consumer (ingest.ts, gate-hook.ts's path check,
# know-reader.ts's subprocess cwd) then agrees on the same absolute path
# regardless of where the process was launched from.
DOCUMENT_ROOT=./documents

# הסודות שהפניית credential_ref של שורת connection_bindings מצביעה אליהם
# נשמרים מוצפנים, לפי עסק, בטבלת `credentials`
# (src/governance/credential-store.ts), ונפתחים במפתח האב שמוגדר למטה. זה
# מה ש-`storedCredentials` פותר עבור כל צעד תוכנית — וגם עבור התראת האישור
# הממתין (ראה NOTIFY_CREDENTIAL_REF למטה). envCredentials
# (src/orchestrator/credentials.ts), שקורא ASSISTANT_CREDENTIAL_<ref>
# ממשתני התהליך, נשאר לבדיקות בלבד ואינו רץ בייצור.
#
# מתאם הדואר (src/mail/transport.ts) מזדהה אך ורק מהסוד שנפתר לשליחה
# הספציפית — אין שם ברירת מחדל, ולכן שליחה בלי credential שנפתר לא קורית
# בכלל. סיסמת תיבת הדואר עצמה לא מוגדרת כאן: היא מוקצית עם
# `npm run secret put <ref> <מפעיל>` (קוראת את הסוד מהקלט הסטנדרטי), תחת
# ה-credential_ref שהחיבור מגדיר בתקנון/ב-binding. עד שהיא מוקצית, כל
# mail.send נדחה ב-credential_unavailable.

# Path to the master key file that opens every stored secret (32 raw bytes).
# Read once at startup, never from the environment otherwise — an env var is
# inherited by child processes and reaches crash dumps and logs, exactly what
# a secret's own key must not do. Created by `secret-key create`.
# Required for `npm run scheduler` and for the `secret`/`secret-key` CLIs;
# nothing here defaults it.
# The file itself must NOT be committed to git (already covered by the
# repo-wide secret rules above) and must NOT be backed up alongside the
# database — one backup holding both the encrypted rows and the key that
# opens them defeats the entire design. Back it up separately; its
# passphrase-protected recovery copy (<path>.recovery, written next to it by
# `secret-key create`/`rotate`) is the one exception allowed to sit beside a
# database backup — but only for as long as its passphrase is not stored with
# it. That passphrase is the single thing between such a backup and every
# secret in the installation, and whoever holds the copy can guess at it
# offline, without limit and without anyone knowing. `secret-key` requires at
# least 16 characters and asks for it twice; keep it somewhere the backup does
# not reach.
CREDENTIAL_KEY_PATH=./secrets/master.key

# חיבור Google (OAuth) — טקס ההרשאה שמסך /connections מפעיל
# (src/dashboard/oauth-routes.ts) צריך את זהות ה-OAuth client של האפליקציה
# עצמה מול Google, כדי להגיע בכלל לעמוד ההסכמה. אלה **סודות שמורים
# במאגר המוצפן, לא משתני סביבה** — בדיוק כמו סיסמת תיבת הדואר למעלה,
# ומאותה סיבה: משתנה סביבה עובר בירושה לתת-תהליכים ומופיע בדוחות קריסה.
# אין להם כאן שורת ערך; הם מוקצים פעם אחת להתקנה עם:
#
#   npm run secret put GOOGLE_OAUTH_CLIENT_ID <המפעיל שלך>
#   npm run secret put GOOGLE_OAUTH_CLIENT_SECRET <המפעיל שלך>
#
# תחת ה-OAuth client שנוצר ב-Google Cloud Console (סוג "Web application"),
# ש-redirect URI הרשום שלו חייב להיות זהה בייט-לבייט ל-
# `<DASHBOARD_BASE_URL>/oauth/callback`. בלעדי שתי ההפניות האלה,
# handleOAuthStart מסרב מיד ב"תצורה חסרה" — לפני שהבעלים מגיע לעמוד
# ההסכמה. ראה docs/live-thread-runbook.md §10 להרצה מלאה.

# מתאם הדואר (buildRuntime, src/orchestrator/runtime.ts). חמשת המשתנים
# האלה נקראים יחד — חסר ולו אחד משאיר את מתאם הדואר לא בנוי, מה שמשתיק גם
# את מייל הודעת בקשת האישור (ראה docs/live-thread-runbook.md). ריק נחשב
# כמו לא-מוגדר. אין כאן SMTP_PASS: `SMTP_USER` מזהה את החשבון בלבד ואינו
# סוד, וכל שליחה מזדהה מהסוד שנפתר מהמאגר (הבלוק למעלה, ו-
# NOTIFY_CREDENTIAL_REF למטה) — לא ממשתנה סביבה כלשהו.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=assistant@example.com
SMTP_USER=assistant

# `SMTP_SECURE=true` הוא TLS מרומז (כל הסשן מוצפן מהבייט הראשון, פורט 465).
# `false` הופך את STARTTLS ל**חובה**, ואין הגדרה שלישית: עד 25/09 הייתה
# אחת, בהשמטה, והיא הייתה ברירת המחדל — nodemailer היה מתחבר בטקסט גלוי
# ומשדרג רק אם השרת מפרסם STARTTLS, כך שמי שיושב על הנתיב ומוחק את השורה
# האחת הזו מקבל את הסיסמה מילה במילה. השורה הבאה היא היציאה מזה, ורק
# לתיבת בדיקה מקומית שאינה מדברת TLS בכלל (maildev, שהמדריך משתמש בו):
# `1` בדיוק, וכל ערך אחר נחשב כבוי — ובכל עלייה שבה הוא דלוק buildRuntime
# מדפיס אזהרה, כי הסיכון היחיד כאן הוא שזה יישאר דלוק בשקט בייצור.
#
# **מושאר מכוון כשורת הערה ולא כערך.** הערכים למעלה בקובץ הזה הם ברירות
# מחדל לפיתוח (127.0.0.1:1025 = maildev), ומי שמעתיק אותו ל-.env של ייצור
# מחליף את HOST ואת PORT כי בלעדי זה שום דבר לא עובד — אבל שורה כמו זו
# פשוט תישאר, ואז ההנמכה מותרת בייצור בשקט. הסרת ההערה היא צעד מכוון
# לתיבה מקומית, ו-docs/live-thread-runbook.md אומר זאת במקום שזה נחוץ.
# SMTP_ALLOW_CLEARTEXT=1

# Owner address for the "an approval is waiting" email. Optional: without it
# the approval still queues and shows on the dashboard, nobody is emailed.
APPROVAL_NOTIFY_TO=owner@example.com

# הפניית הסוד שהתראת "יש אישור ממתין" מזדהה איתה (createEmailNotifier,
# src/governance/notify.ts) — הפניה **נפרדת** מזו של החיבור הרגיל למייל,
# כי להתראה הזו אין binding משלה בתקנון.
#
# **חסר לעומת שגוי — שתי התנהגויות שונות, וזה מה שצריך לדעת ברגע שמשהו
# לא עובד:** לא מוגדר או ריק = **אזהרה** בלבד; אין הודעת מייל, האישור
# עדיין נכתב ומופיע בדשבורד, וה-scheduler ממשיך לרוץ כרגיל. ערך שאינו ref
# חוקי (אותיות גדולות, ספרות וקו תחתון בלבד) = **סירוב עלייה**;
# buildRuntime זורק, וה-scheduler כולו לא עולה. זה בכוונה: מתג שהמפעיל
# השאיר כבוי הוא החלטה, ואילו שגיאת הקלדה היא תקלה, וגילוי שלה בבקשת
# האישור הראשונה בעוד שעתיים גרוע מסירוב עכשיו.
#
# הסוד עצמו מוקצה עם `npm run secret put <ref> <מפעיל>`, כאשר <ref> הוא
# הערך שנקבע כאן — לעולם לא כאן ולא במשתנה סביבה.
#
# **שתי ההפניות אינן זהות כאן בכוונה** (מפרט §4): זה מה שמאפשר לסבב אחת
# בלי לגעת בשורה של השנייה. אבל **שתיהן נפתרות לסיסמה של אותו חשבון**
# היום — יש `SMTP_USER` אחד ו-transport אחד — ולכן מפעיל שיציב כאן סיסמה
# *אחרת* מזו של OFFICE_MAIL יראה את ההתראות נכשלות באימות מול השרת בזמן
# שהדואר הרגיל עובד. שם משתמש לכל שליחה הוא ההמשך שיהפוך את ההפרדה
# לאמיתית, והוא טרם נבנה.
NOTIFY_CREDENTIAL_REF=NOTIFY_MAIL

# The charter's system name for the mailbox connection (buildRuntime).
# Optional; defaults to office-mail.
MAIL_SYSTEM=office-mail

# Base URL baked into the link inside an approval-request email. Optional;
# defaults to http://127.0.0.1:8787, which will not match the dashboard's own
# default port (4173, run-dashboard.ts) unless you set this to match.
DASHBOARD_BASE_URL=http://127.0.0.1:4173

# תיקייה שהמערכת סורקת. ריק או חסר = הסריקה כבויה.
DOCUMENT_INBOX=
# כמה מסמכים מותר להבין ביום. קריאה מהמטמון אינה נספרת.
DOCUMENT_READS_PER_DAY=20
# כמה מיילים נכנסים מותר לסווג במודל ביום. מייל שנמשך אחרי התקרה נרשם ומוצג כ"לא נקרא", ונקרא אחרי האיפוס.
MAIL_READS_PER_DAY=200
# כמה משימות ביום מותר לאוצר לשלוח למודל. 0 מכבה את האצירה לגמרי.
CURATION_RUNS_PER_DAY=20
# כמה בקשות עזרה בין סוכנים (האצלות) מותרות ביום — כל אחת עולה לפחות קריאת מודל אחת בבת.
DELEGATIONS_PER_DAY=50
# תמלול הקלטות וואטסאפ: שני תקציבים נפרדים, כדי שזר לא ירוקן את התקציב של הבעלים.
WHATSAPP_TRANSCRIBE_BOSS_PER_DAY=40
WHATSAPP_TRANSCRIBE_OTHER_PER_DAY=20
# הקלטה ארוכה מזה לא נשלחת לספק התמלול בכלל.
WHATSAPP_MAX_AUDIO_SECONDS=180
# כמה הוראות ביום — כל הוראה מפעילה את המתכנן.
WHATSAPP_INSTRUCTIONS_PER_DAY=50
# כמה דקות הודעה נקראת כתשובה לשאלת הבהרה פתוחה (§5.4). אחרי החלון — הודעה
# חדשה היא הוראה חדשה. 0 = שום הודעה לא נקראת כתשובה.
WHATSAPP_QUESTION_WINDOW_MINUTES=30

# הפניות הסוד של הגשר לוואטסאפ (GREEN-API) — שתי הפניות נפרדות, מכונה
# ו-token, לא הסודות עצמם (buildRuntime, src/orchestrator/runtime.ts).
# חסר אחת מהן = אזהרה בלבד בעלייה; הגשר לא נבנה, שום דבר אחר לא נפגע.
# ערך שאינו ref חוקי (אותיות גדולות, ספרות וקו תחתון בלבד) = סירוב עלייה,
# אותו כלל בדיוק כמו NOTIFY_CREDENTIAL_REF למעלה. הסוד עצמו מוקצה עם
# `npm run secret put <ref> <מפעיל>`. אין עדיין מימוש אמיתי של הגשר
# (Task 11) — גם עם שתי ההפניות מוגדרות ונפתרות, עד אז זו עדיין אזהרה.
GREEN_API_INSTANCE_REF=GREEN_API_INSTANCE
GREEN_API_TOKEN_REF=GREEN_API_TOKEN
